{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-utro-io",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdash-utro-io",
			// Run `wrangler d1 create my-emdash-site` and paste the real ID here for deploy
			"database_id": "f6423092-4932-495f-aea4-05a596a6b5fd",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdash-utro-io","preview_bucket_name": "emdash-utro-io",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
}
